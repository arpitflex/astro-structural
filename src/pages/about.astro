---
import Layout from '@layouts/Layout.astro';
import Section from '@components/layout/Section.astro';
import NameMark from '@components/navigation/NameMark.astro';
import { ABOUT } from '@data/about';
import { SITE } from '@data/site';

const elsewhere = [
  ...(SITE.email ? [{ label: 'email', value: SITE.email, href: `mailto:${SITE.email}` }] : []),
  ...SITE.socials.map((social) => ({ label: social.label, value: social.value, href: social.url }))
].map((link) => ({ ...link, external: link.href.startsWith('http') }));
---

<Layout title="about" description={ABOUT.description}>
  <NameMark>about</NameMark>

  {ABOUT.now && (
    <Section label="now" now statement>
      {ABOUT.now}
    </Section>
  )}

  {ABOUT.before.length > 0 && (
    <Section label="before">
      <div class="ag-prose">
        {ABOUT.before.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </Section>
  )}

  {elsewhere.length > 0 && (
    <Section label="elsewhere">
      <ul class="ag-linklist">
        {elsewhere.map((link) => (
          <li>
            <a
              href={link.href}
              class="ag-linkrow"
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'me noopener noreferrer' : undefined}
            >
              <span class="ag-linkrow__k">{link.label}</span>
              <span class="ag-linkrow__v">
                {link.value}
                {link.external && <span aria-hidden="true">↗</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )}

  {ABOUT.colophon && (
    <Section label="colophon">
      <div class="ag-prose">
        <p>{ABOUT.colophon}</p>
      </div>
    </Section>
  )}
</Layout>
